#endif

/* BOARD_STREAM_CH (10-12): channel-independent full-buffer ports run through their
 * <pfx>_forward_ch API, one channel at a time; since 10-13 through <pfx>_forward_emit with no output buffer,
 * at the dataset's real channel count.  The full H x D golden would not fit the flash at
 * D = 28 / H = 720, so board_prep.py writes board_gold_ch.h: channel 0 element by element
 * plus every channel's sum / absolute sum (x86 tests check every element bit-exactly). */
#if defined(BOARD_STREAM_CH)
  #if !defined(FULL_FORWARD)
    #error "BOARD_STREAM_CH needs a full-buffer port with a _ch API"
  #endif
  #include "board_gold_ch.h"
  #define CH_FWD_(f) f##_emit       /* 10-13: per-value emit, no output buffer */
  #define CH_FWD(f) CH_FWD_(f)
#endif
