/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
extern uint32_t _estack;   /* top of RAM  (stack start, high address) */
extern uint32_t _end;      /* end of .bss / heap base (low address)   */

#define STACK_FILL 0xAAAAAAAAu

/* paint the currently-free stack region with 0xAA */
__attribute__((noinline)) static void stack_paint(void)
{
  register uint32_t *sp asm("sp");
  uint32_t *p = &_end;
  while (p < sp) { *p++ = STACK_FILL; }
}

/* peak stack used so far = total region - bytes still holding 0xAA */
static uint32_t stack_peak_used(void)
{
  uint32_t *p = &_end;
  uint32_t untouched = 0;
  while (p < &_estack && *p == STACK_FILL) { untouched++; p++; }
  uint32_t total = (uint32_t)((uint8_t *)&_estack - (uint8_t *)&_end);
  return total - untouched * 4u;
}

/* the caller's input window, in SRAM (counted in the footprint table too) */
static float s_x[BOARD_L * BOARD_D];

#if defined(BOARD_STREAM_CH)
/* 10-13: no output buffer - <pfx>_forward_emit hands each value to emit_sink (below) */
#elif defined(FULL_FORWARD) || defined(RUN_PERS)
/* full-buffer API only: the caller owns y.  board_prep.py only builds these
 * ports at (H, D) where this buffer fits; at H = 720 they run with D = 1 and
 * the per-channel latency is multiplied by D (channel-independent models). */
static float s_y[BOARD_H * BOARD_D];
#endif

static volatile float g_sink;  /* timed run: keep one value per block */
static int   g_bad;
static float g_maxabs;

static inline void check(float got, float ref)
{
  float ad = fabsf(got - ref);
  if (ad > g_maxabs) g_maxabs = ad;
  if (!(ad <= 1e-5f + 1e-4f * fabsf(ref))) g_bad++;   /* NaN counts as bad */
}

#if defined(BOARD_STREAM_CH)
static int    g_check;
static double g_sum;
/* each forecast value as it is final; timed run keeps one, check run compares channel 0
 * element by element and sums every channel (in emission order) */
static void emit_sink(int d, int t, float v)
{
  if (!g_check) { g_sink = v; return; }
  if (d == 0) check(v, GOLD_Y_CH0[t]);
  g_sum += v;
}
#endif

/* one inference; check = 0 -> timed sink, check = 1 -> compare to golden */
static void infer(int check_it)
{
#if defined(RUN_FEATHER_MIX) || defined(RUN_FEATHER_FN)
  fea2r_begin(s_x);
  for (int d = 0; d < BOARD_D; ++d) {
    fea2r_channel(d);
    for (int om = 0; om < FEA2_M; ++om) {
      const float *blk = fea2r_block(om);
      if (!check_it) { g_sink = blk[0]; continue; }
      for (int ph = 0; ph < FEA2_SEG; ++ph)
        check(blk[ph], GOLD_Y[(om * FEA2_SEG + ph) * BOARD_D + d]);
    }
  }
#elif defined(RUN_FEATHER_CI)
  for (int c = 0; c < BOARD_D; ++c) {
    fea2ci_begin(s_x, c);
    for (int om = 0; om < FEA2_M; ++om) {
      const float *blk = fea2ci_block(om);
      if (!check_it) { g_sink = blk[0]; continue; }
      for (int ph = 0; ph < FEA2_SEG; ++ph)
        check(blk[ph], GOLD_Y[(om * FEA2_SEG + ph) * BOARD_D + c]);
    }
  }
#elif defined(RUN_DLINEAR)
  for (int c = 0; c < BOARD_D; ++c) {
    dl_begin(s_x, c);
    for (int t = 0; t < BOARD_H; ++t) {
      float v = dl_step(t);
      if (!check_it) g_sink = v;
      else check(v, GOLD_Y[t * BOARD_D + c]);
    }
  }
#elif defined(RUN_CYCLENET)
  for (int c = 0; c < BOARD_D; ++c) {
    cn_begin(s_x, c, 0);                     /* phase 0, as in the sweeps */
    for (int t = 0; t < BOARD_H; ++t) {
      float v = cn_step(t);
      if (!check_it) g_sink = v;
      else check(v, GOLD_Y[t * BOARD_D + c]);
    }
  }
#elif defined(RUN_PERS)
  pers_forward(s_x, s_y, BOARD_L, BOARD_H, BOARD_D);
  if (check_it)
    for (int t = 0; t < BOARD_H; ++t)
      for (int d = 0; d < BOARD_D; ++d)
        check(s_y[t * BOARD_D + d], GOLD_X[(BOARD_L - 1) * BOARD_D + d]);
#elif defined(BOARD_STREAM_CH)
  g_check = check_it;
  for (int d = 0; d < BOARD_D; ++d) {
    g_sum = 0.0;
    CH_FWD(FULL_FORWARD)(s_x, d, emit_sink);
    if (!check_it) continue;
    float ad = (float)fabs(g_sum - GOLD_SUM[d]);
    if (ad > g_maxabs) g_maxabs = ad;
    if (!(ad <= 1e-5f * BOARD_H + 1e-4f * GOLD_ABSSUM[d])) g_bad++;
  }
#else
  FULL_FORWARD(s_x, s_y);
  if (check_it)
    for (int i = 0; i < BOARD_H * BOARD_D; ++i)
      check(s_y[i], GOLD_Y[i]);
#endif
}

static void measure(void)
{
  memcpy(s_x, GOLD_X, sizeof(s_x));          /* window lives in SRAM */

  uint32_t t0, t1;
  __disable_irq();
  t0 = DWT->CYCCNT;
  infer(0);
  t1 = DWT->CYCCNT;
  __enable_irq();
  uint32_t cyc = t1 - t0;

  g_bad = 0;
  g_maxabs = 0.0f;
  infer(1);

  printf("%-12s H=%d D=%d %s bad=%d maxabs(x1e6)=%lu cycles=%lu latency_us=%lu stack=%lu B\r\n",
         BOARD_NAME, BOARD_H, BOARD_D, g_bad ? "FAIL" : "PASS", g_bad,
         (unsigned long)(g_maxabs * 1e6f),
         (unsigned long)cyc, (unsigned long)(cyc / 72u),
         (unsigned long)stack_peak_used());
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  setvbuf(stdout, NULL, _IONBF, 0);
  printf("hello from F103RB  [%s H=%d D=%d]\r\n", BOARD_NAME, BOARD_H, BOARD_D);

  /* --- DWT cycle counter enable (latency measurement tool) --- */
  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
  DWT->CYCCNT = 0;
  DWT->CTRL  |= DWT_CTRL_CYCCNTENA_Msk;

  memcpy(s_x, GOLD_X, sizeof(s_x));

#if defined(POWER_MAX)
  /* sanity check of the current measurement only (not a paper number): every
   * peripheral clock on + LED on while the model runs back to back */
  __HAL_RCC_AFIO_CLK_ENABLE();  __HAL_RCC_ADC1_CLK_ENABLE();  __HAL_RCC_ADC2_CLK_ENABLE();
  __HAL_RCC_TIM1_CLK_ENABLE();  __HAL_RCC_SPI1_CLK_ENABLE();  __HAL_RCC_USART1_CLK_ENABLE();
  __HAL_RCC_TIM2_CLK_ENABLE();  __HAL_RCC_TIM3_CLK_ENABLE();  __HAL_RCC_TIM4_CLK_ENABLE();
  __HAL_RCC_SPI2_CLK_ENABLE();  __HAL_RCC_USART3_CLK_ENABLE(); __HAL_RCC_I2C1_CLK_ENABLE();
  __HAL_RCC_I2C2_CLK_ENABLE();  __HAL_RCC_USB_CLK_ENABLE();   __HAL_RCC_CAN1_CLK_ENABLE();
  __HAL_RCC_BKP_CLK_ENABLE();   __HAL_RCC_PWR_CLK_ENABLE();   __HAL_RCC_DMA1_CLK_ENABLE();
  __HAL_RCC_CRC_CLK_ENABLE();
  HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
#endif

  /* --- stack painting: fill free stack with 0xAA before any work --- */
  stack_paint();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
#if defined(POWER_IDLE)
    /* CPU sleeps -> DMM reads idle/sleep current (model-independent) */
    __WFI();
#elif defined(POWER_ACTIVE) || defined(POWER_MAX)
    /* back-to-back inference, no UART/LED/delay -> steady active current */
    infer(0);
#else
    /* normal: timed + golden-checked, one row per ~2 s */
    measure();
    /* visible heartbeat: 5 quick green (LD2) blinks so you can SEE it alive */
    for (int k = 0; k < 10; k++) {
      HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
      HAL_Delay(120);
    }
    HAL_Delay(400);
#endif
  }
  /* USER CODE END 3 */
}

