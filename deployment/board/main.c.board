/*
 * Board measurement harness, 2026-09-29 (re-frozen model).  Replaces the
 * 08-24 harness (main.c.reference), which drove the old 938p FEATHer and
 * compared a full (H x D) output buffer - impossible at H = 720 in 20 KB.
 *
 * WHAT TO MEASURE is not edited here.  Run, on the PC:
 *     python deployment/board/board_prep.py --model <m> --H <h> --D <d> [--power active|idle]
 * It exports the golden vectors for that cell, writes Core/Inc/board_cfg.h
 * (RUN_* switch + geometry) and syncs the sources.  Then Build -> Run here.
 *
 * Per measurement:
 *   - the golden input is COPIED INTO SRAM first (a deployed MCU reads its
 *     window from RAM; reading const flash has wait states and would bias the
 *     latency of every model the same way, but not realistically);
 *   - one timed inference: the forecast is streamed block by block into a
 *     sink that keeps one value, so no model is charged for a buffer it would
 *     not need (ports with only a full-buffer API get the caller's y buffer,
 *     exactly as in the footprint table);
 *   - one untimed inference compared against the PyTorch golden.
 * Output line:  <name> H=.. D=.. PASS|FAIL bad maxabs cycles latency_us stack
 */
#include <stdio.h>
#include <math.h>
#include <string.h>
#include "board_cfg.h"

#if defined(RUN_FEATHER_MIX)
  #include "feather2r_infer.h"
  #include "feather2_vectors.h"      /* G2_X / G2_Y */
  #define GOLD_X G2_X
  #define GOLD_Y G2_Y
#elif defined(RUN_FEATHER_FN)           /* front=none control arm (10-07) */
  #include "feather2r_infer.h"
  #include "feather2fn_vectors.h"    /* G2_X / G2_Y */
  #define GOLD_X G2_X
  #define GOLD_Y G2_Y
#elif defined(RUN_FEATHER_CI)
  #include "feather2ci_infer.h"
  #include "feather2ci_vectors.h"    /* GCI_X / GCI_Y */
  #define GOLD_X GCI_X
  #define GOLD_Y GCI_Y
#elif defined(RUN_DLINEAR)
  #include "dlinear_infer.h"
  #include "dlinear_vectors.h"       /* GD_X / GD_Y */
  #define GOLD_X GD_X
  #define GOLD_Y GD_Y
#elif defined(RUN_CYCLENET)
  #include "cyclenet_infer.h"
  #include "cyclenet_vectors.h"      /* GC_X / GC_Y */
  #define GOLD_X GC_X
  #define GOLD_Y GC_Y
#elif defined(RUN_STSF)
  #include "stsf_infer.h"
  #include "stsf_vectors.h"
  #define GOLD_X SG_X
  #define GOLD_Y SG_Y
  #define FULL_FORWARD stsf_forward
#elif defined(RUN_STSF_MLP)
  #include "stsf_mlp_infer.h"
  #include "stsf_mlp_vectors.h"
  #define GOLD_X SM_X
  #define GOLD_Y SM_Y
  #define FULL_FORWARD stsf_mlp_forward
#elif defined(RUN_MIXLINEAR)
  #include "mixlinear_infer.h"
  #include "mixlinear_vectors.h"
  #define GOLD_X MG_X
  #define GOLD_Y MG_Y
  #define FULL_FORWARD mixlinear_forward
#elif defined(RUN_DIPE)
  #include "dipe_infer.h"
  #include "dipe_vectors.h"
  #define GOLD_X DG_X
  #define GOLD_Y DG_Y
  #define FULL_FORWARD dipe_forward
#elif defined(RUN_FITS)
  #include "fits_infer.h"
  #include "fits_vectors.h"
  #define GOLD_X FG_X
  #define GOLD_Y FG_Y
