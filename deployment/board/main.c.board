  #define GOLD_Y SFG_Y
  #define FULL_FORWARD samformer_forward
#elif defined(RUN_PERS)
  #include "pers_infer.h"
  #include "stsf_vectors.h"          /* any (L, D) window will do */
  #define GOLD_X SG_X
#else
