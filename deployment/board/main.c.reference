/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
extern uint32_t _estack;   /* top of RAM  (stack start, high address) */
extern uint32_t _end;      /* end of .bss / heap base (low address)   */

#define STACK_FILL 0xAAAAAAAAu

/* paint the currently-free stack region with 0xAA */
__attribute__((noinline)) static void stack_paint(void)
{
  register uint32_t *sp asm("sp");
  uint32_t *p = &_end;
  while (p < sp) { *p++ = STACK_FILL; }
}

/* peak stack used so far = total region - bytes still holding 0xAA */
static uint32_t stack_peak_used(void)
{
  uint32_t *p = &_end;
  uint32_t untouched = 0;
  while (p < &_estack && *p == STACK_FILL) { untouched++; p++; }
  uint32_t total = (uint32_t)((uint8_t *)&_estack - (uint8_t *)&_end);
  return total - untouched * 4u;
}

/* shared output + persistence reference (all models are 96x7) */
#define OUT_N (96 * 7)
static float g_yout[OUT_N];
static float g_pref[OUT_N];

/* time one inference, compare to golden, print one table row */
static void measure(const char *name,
                    void (*fwd)(const float *, float *),
                    const float *x, const float *gy)
{
  uint32_t t0, t1;
  __disable_irq();
  t0 = DWT->CYCCNT;
  fwd(x, g_yout);
  t1 = DWT->CYCCNT;
  __enable_irq();
  uint32_t cyc = t1 - t0;

  int bad = 0;
  float maxabs = 0.0f;
  for (int i = 0; i < OUT_N; i++) {
    float ad = fabsf(g_yout[i] - gy[i]);
    if (ad > maxabs) maxabs = ad;
    if (ad > 1e-5f + 1e-4f * fabsf(gy[i])) bad++;
  }
  printf("%-10s %s bad=%d maxabs(x1e6)=%lu cycles=%lu latency_us=%lu stack=%lu B\r\n",
         name, bad ? "FAIL" : "PASS", bad,
         (unsigned long)(maxabs * 1e6f),
         (unsigned long)cyc, (unsigned long)(cyc / 72u),
         (unsigned long)stack_peak_used());
}

/* persistence has an extra-arg signature -> wrap to the uniform type */
static void pers_fwd_wrap(const float *x, float *y)
{
  pers_forward(x, y, 96, 96, 7);
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  setvbuf(stdout, NULL, _IONBF, 0);
  printf("hello from F103RB\r\n");

  /* --- DWT cycle counter enable (latency measurement tool) --- */
  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
  DWT->CYCCNT = 0;
  DWT->CTRL  |= DWT_CTRL_CYCCNTENA_Msk;

#ifdef RUN_PERS
  /* persistence reference = last timestep of SG_X repeated H times */
  for (int t = 0; t < 96; t++)
    for (int d = 0; d < 7; d++)
      g_pref[t * 7 + d] = SG_X[(96 - 1) * 7 + d];
#endif

  /* --- stack painting: fill free stack with 0xAA before any work --- */
  stack_paint();
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);

#if defined(POWER_IDLE)
    /* CPU sleeps -> DMM reads idle/sleep current (model-independent) */
    __WFI();
#elif defined(POWER_ACTIVE)
    /* back-to-back inference, no UART/LED/delay -> steady active current */
  #if defined(RUN_FEATHER)
    feather_forward(G_X, g_yout);
  #elif defined(RUN_STSF)
    stsf_forward(SG_X, g_yout);
  #elif defined(RUN_STSF_MLP)
    stsf_mlp_forward(SM_X, g_yout);
  #elif defined(RUN_MIXLINEAR)
    mixlinear_forward(MG_X, g_yout);
  #elif defined(RUN_DIPE)
    dipe_forward(DG_X, g_yout);
  #elif defined(RUN_FITS)
    fits_forward(FG_X, g_yout);
  #elif defined(RUN_PERS)
    pers_fwd_wrap(SG_X, g_yout);
  #endif
#else
    /* normal: timed + golden-checked, one row per 2 s */
    HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
  #if defined(RUN_FEATHER)
    measure("FEATHer",   feather_forward, G_X, G_Y);
  #elif defined(RUN_STSF)
    measure("SparseTSF", stsf_forward,  SG_X, SG_Y);
  #elif defined(RUN_STSF_MLP)
    measure("STSF-MLP",  stsf_mlp_forward, SM_X, SM_Y);
  #elif defined(RUN_MIXLINEAR)
    measure("MixLinear", mixlinear_forward, MG_X, MG_Y);
  #elif defined(RUN_DIPE)
    measure("DiPE",      dipe_forward,  DG_X, DG_Y);
  #elif defined(RUN_FITS)
    measure("FITS",      fits_forward,  FG_X, FG_Y);
  #elif defined(RUN_PERS)
    measure("persist",   pers_fwd_wrap, SG_X, g_pref);
  #endif
    /* visible heartbeat: 5 quick green (LD2) blinks so you can SEE it alive */
    for (int k = 0; k < 10; k++) {
      HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
      HAL_Delay(120);
    }
    HAL_Delay(400);
#endif
  }
  /* USER CODE END 3 */
}

