/* Includes ------------------------------------------------------------------*/
#include "main.h"

/* Private includes ----------------------------------------------------------*/
/* USER CODE BEGIN Includes */
/*
 * STREAMING REPLAY firmware (2026-10-04) - the deployed loop, not the timing
 * harness.  FEATHer-mix with TRAINED weights, installed by
 *     python deployment/board/board_prep.py --model feather_mix --H <h> --D <d> --stream_ckpt <pth>
 * and driven over the ST-LINK virtual COM port by deployment/board/replay.py.
 * The measured harness (main.c.board) is untouched; this file shares its CubeMX
 * parts (clock, GPIO, USART2) byte for byte.
 *
 * Protocol (binary, little endian, 115200 8N1; the PC waits for every reply):
 *   'P'              -> 'p' u16 L, u16 H, u16 D, u16 P          handshake
 *   'S' + D x f32    -> 'k'                                    one new time step
 *   'F'              -> 'Y' + H*D x f32 + u32 cycles             forecast now
 * The forecast is sent in the port's emission order (channel d, output period
 * om, phase ph), each period as soon as it exists, so nothing H-sized is ever
 * buffered (as in the footprint table).  cycles = compute only (DWT), the UART
 * time is excluded; at 72 MHz, latency = cycles / 72 us.
 */
#include <string.h>
#include "board_cfg.h"
#if !defined(RUN_FEATHER_MIX) || !defined(STREAM_MODE)
  #error "main.c.stream drives FEATHer-mix only - run board_prep.py --model feather_mix --stream_ckpt ..."
#endif
#include "feather2r_infer.h"
/* USER CODE END Includes */

/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */

/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define BOARD_L 96
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart2;

/* USER CODE BEGIN PV */

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART2_UART_Init(void);
/* USER CODE BEGIN PFP */

/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
static float s_x[BOARD_L * BOARD_D];     /* the input window, time-major, in SRAM */
static float s_new[BOARD_D];

static void rx(void *buf, uint16_t n) { HAL_UART_Receive(&huart2, (uint8_t *)buf, n, HAL_MAX_DELAY); }
static void tx(const void *buf, uint16_t n) { HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, HAL_MAX_DELAY); }

static void push_sample(void)
{
  rx(s_new, sizeof s_new);
  memmove(s_x, s_x + BOARD_D, (BOARD_L - 1) * BOARD_D * sizeof(float));
  memcpy(s_x + (BOARD_L - 1) * BOARD_D, s_new, sizeof s_new);
}

static void forecast(void)
{
  const uint8_t tag = 'Y';
  uint32_t cyc = 0, t0;
  tx(&tag, 1);
  t0 = DWT->CYCCNT;
  fea2r_begin(s_x);
  cyc += DWT->CYCCNT - t0;
  for (int d = 0; d < BOARD_D; ++d) {
    t0 = DWT->CYCCNT;
    fea2r_channel(d);
    cyc += DWT->CYCCNT - t0;
    for (int om = 0; om < FEA2_M; ++om) {
      t0 = DWT->CYCCNT;
      const float *blk = fea2r_block(om);
      cyc += DWT->CYCCNT - t0;
      tx(blk, FEA2_PERIOD * sizeof(float));
    }
  }
  tx(&cyc, sizeof cyc);
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
  DWT->CYCCNT = 0;
  DWT->CTRL  |= DWT_CTRL_CYCCNTENA_Msk;
  memset(s_x, 0, sizeof s_x);
  /* USER CODE END 2 */

  while (1)
  {
    /* USER CODE BEGIN 3 */
    uint8_t c;
    rx(&c, 1);
    if (c == 'S') {
      const uint8_t ok = 'k';
      push_sample();
      tx(&ok, 1);
    } else if (c == 'F') {
      HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
      forecast();
      HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_RESET);
    } else if (c == 'P') {
      const uint8_t p = 'p';
      const uint16_t geo[4] = {BOARD_L, BOARD_H, BOARD_D, FEA2_PERIOD};
      tx(&p, 1);
      tx(geo, sizeof geo);
    }
    /* any other byte is ignored, so a stray character cannot desynchronise the loop */
    /* USER CODE END 3 */
  }
}

